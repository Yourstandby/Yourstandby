---
import Base from '../layouts/Base.astro';
import SecHead from '../components/SecHead.astro';
import Ember from '../components/Ember.astro';
import Gauge from '../components/Gauge.astro';
import PlayerPanel from '../components/PlayerPanel.astro';
import QuestLog from '../components/QuestLog.astro';
import Inventory from '../components/Inventory.astro';
import LogPanel from '../components/LogPanel.astro';
import CommsPanel from '../components/CommsPanel.astro';
import ContribPanel from '../components/ContribPanel.astro';
import PartyPanel from '../components/PartyPanel.astro';
import QuestStage from '../components/QuestStage.astro';
import { site, base } from '../data/site.ts';
import iconData from '../data/icons.generated.json';

// 模板里不能写 TS 类型断言，统一在 frontmatter 定型
const ICONS = iconData as Record<string, { title: string; hex: string; path: string }>;
---
<Base>
  <section class="hero wrap">
    <div class="hero__art"><Ember size={120} /></div>
    <div class="hero__text">
      <p class="hero__kicker">BUILDING IN PUBLIC SINCE 2024</p>
      <h1 class="hero__title">YOUR<br />STANDBY</h1>
      <p class="typed"><span class="typed__mask">{site.tagline}</span><span class="px-caret" aria-hidden="true"></span></p>
      <div class="hero__cta">
        <a class="px-btn" href={`${base}/notes/`}>读手账</a>
        <a class="px-btn" href={site.github}>GitHub ↗</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="sec" data-dither>
      <SecHead no="01" title="DASHBOARD" id="dashboard" />
      <div class="dash">
        <PartyPanel />
        <PlayerPanel />
        <QuestLog />
        <Inventory />
        <LogPanel />
        <CommsPanel />
        <ContribPanel />
      </div>
    </section>


    <section class="sec" data-dither id="trials-section">
      <SecHead no="02" title="TEN TRIALS" id="trials" />
      <QuestStage />
    </section>

    <section class="sec" data-dither>
      <SecHead no="03" title="STACK" id="stack" />
      <div class="stack-list">
        {site.stack.map((s) => (
          <div class="stack-row">
            <span class="gauge__label">{s.label}</span>
            <Gauge value={s.pct} max={s.max} cells={14} tone="cyan" label={`${s.label} ${s.pct}/${s.max}`} />
            <span class="stack-tiles">
              {s.items.map((slug) => {
                const ic = ICONS[slug];
                if (!ic) return null;
                return (
                  <span class="stack-tile" style={`--c:${ic.hex}`} title={ic.title}>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path d={ic.path} fill="#fff" />
                    </svg>
                  </span>
                );
              })}
            </span>
          </div>
        ))}
      </div>
    </section>

    <section class="sec" data-dither>
      <SecHead no="04" title="PROJECTS" id="projects" />
      <div class="grid-2">
        {site.projects.map((p) => (
          <a class="card" href={p.repo}>
            <span class="card__kicker">{p.tag}</span>
            <h3 class="card__title">{p.name}</h3>
            <p class="card__desc">{p.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid; gap: var(--space-6);
    grid-template-columns: 1fr; align-items: center;
    padding: var(--space-8) 0 var(--space-4);
  }
  @media (min-width: 768px) { .hero { grid-template-columns: 200px 1fr; } }
  .hero__art { display: flex; justify-content: center; }
  .hero__kicker {
    font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: 3px;
    color: var(--ash); margin: 0 0 var(--space-2);
  }
  .hero__title {
    font-family: var(--font-display); font-size: clamp(28px, 7vw, var(--fs-3xl));
    line-height: 1.15; margin: 0 0 var(--space-3); letter-spacing: 2px;
    color: var(--ink); text-shadow: 4px 4px 0 var(--ember-deep);
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .stack-list { display: grid; gap: var(--space-3); }
  .stack-row { display: grid; grid-template-columns: 1fr; gap: 6px; }
  @media (min-width: 768px) {
    .stack-row { grid-template-columns: 110px auto 1fr; align-items: center; }
  }
  /* 技术徽章：品牌色底 + 像素字母，替代文字描述 */
  .stack-tiles { display: flex; flex-wrap: wrap; gap: 6px; }
  .stack-tile {
    display: inline-grid; place-items: center;
    width: 30px; height: 30px; flex: none;
    background: var(--c); color: #fff;
    border: 2px solid var(--line);
    font-family: var(--font-mono); font-size: 11px; line-height: 1;
    letter-spacing: 0; text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.45);
    transition: transform var(--dur-press) var(--ease-step);
  }
  .stack-tile:hover { transform: translateY(-2px); }
</style>
