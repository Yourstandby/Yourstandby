---
import Base from '../../layouts/Base.astro';
import SecHead from '../../components/SecHead.astro';
import { getCollection } from 'astro:content';
import { base } from '../../data/site.ts';
import Bi from '../../components/Bi.astro';
import { copy } from '../../i18n/copy.ts';

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={copy.notes.title.en} titleZh={copy.notes.title.zh}>
  <div class="wrap">
    <section class="sec" style="padding-top: var(--space-6)">
      <SecHead no="06" title="NOTES" titleZh={copy.sections.notes.zh} />
      <p class="card__desc"><Bi {...copy.notes.desc} /></p>
      <ul class="list">
        {notes.map((n) => (
          <li class="card">
            <span class="card__kicker">ISSUE {String(n.data.issue).padStart(2, '0')} · {n.data.date.toISOString().slice(0, 10)}</span>
            <h3 class="card__title"><a href={`${base}/notes/${n.id}/`}><Bi en={n.data.titleEn ?? n.data.title} zh={n.data.title} /></a></h3>
            {n.data.summary && <p class="card__desc"><Bi en={n.data.summaryEn ?? n.data.summary} zh={n.data.summary} /></p>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .list { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: grid; gap: var(--space-4); }
</style>
