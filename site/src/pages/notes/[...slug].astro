---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { base } from '../../data/site.ts';
import Bi from '../../components/Bi.astro';
import { copy } from '../../i18n/copy.ts';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
// 英文正文是同一 issue 的另一份 markdown：有就两块都渲染，没有就只出中文
const enEntry = (await getCollection('notesEn')).find((n) => n.id === note.id);
const EnBody = enEntry ? (await render(enEntry)).Content : null;
---
<Base
  title={note.data.titleEn ?? note.data.title}
  titleZh={note.data.title}
  description={note.data.summaryEn ?? note.data.summary}
  descriptionZh={note.data.summary}
>
  <article class="wrap note">
    <p class="card__kicker">ISSUE {String(note.data.issue).padStart(2, '0')} · {note.data.date.toISOString().slice(0, 10)}</p>
    <h1><Bi en={note.data.titleEn ?? note.data.title} zh={note.data.title} /></h1>
    {EnBody ? (
      <>
        <div class="bi-block" data-for="en"><EnBody /></div>
        <div class="bi-block" data-for="zh"><Content /></div>
      </>
    ) : (
      <>
        <Content />
        <p class="card__desc"><Bi {...copy.notes.untranslated} /></p>
      </>
    )}
    <p><a href={`${base}/notes/`}><Bi {...copy.notes.back} /></a></p>
  </article>
</Base>

<style>
  /* 正文 24px，960px 才有约 40 字/行；760px 在 24px 下只剩 30 字，读起来憋 */
  .note { max-width: 960px; padding-top: var(--space-7); }
  .note h1 {
    font-family: var(--font-display); font-size: var(--fs-lg);
    line-height: 1.2; margin: var(--space-3) 0 var(--space-5); color: var(--ink);
  }
  .note h2 {
    font-family: var(--font-display); font-size: var(--fs-sm);
    margin: var(--space-6) 0 var(--space-3); color: var(--ember);
  }
  .note p, .note li { color: var(--ink-dim); }
  .note code {
    font-family: var(--font-mono); background: var(--surface-2);
    border: var(--px-hair) solid var(--line); padding: 2px 8px; color: var(--ink);
  }
</style>
