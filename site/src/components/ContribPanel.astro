---
import Bi from './Bi.astro';
import { copy } from '../i18n/copy.ts';

const RAW = 'https://raw.githubusercontent.com/Yourstandby/Yourstandby/main/profile';
const alt = copy.a11y.contrib;
---
<section class="panel span-12">
  <div class="panel__head"><span class="panel__tag"><Bi {...copy.panels.contrib} /></span></div>
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset={`${RAW}/contrib-dark.svg`} />
    <img
      src={`${RAW}/contrib-light.svg`}
      alt={alt.en}
      data-a11y-attr="alt"
      data-a11y-en={alt.en}
      data-a11y-zh={alt.zh}
      width="721"
      loading="lazy"
      decoding="async"
    />
  </picture>
</section>

<style>
  .panel img { display: block; max-width: 100%; height: auto; }
</style>
