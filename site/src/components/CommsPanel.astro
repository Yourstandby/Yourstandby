---
import player from '../data/player.generated.json';
import Bi from './Bi.astro';
import { copy } from '../i18n/copy.ts';
const links = player.links;
---
<section class="panel span-5">
  <div class="panel__head"><span class="panel__tag"><Bi {...copy.panels.comms} /></span></div>
  <ul class="comms">
    {links.map((l) => (
      <li>
        <span class="comms__live" aria-hidden="true"></span>
        <span class="comms__label">{l.label}</span>
        <span class="comms__value">{l.value}</span>
        <span class="comms__state"><Bi {...copy.panels.online} /></span>
      </li>
    ))}
  </ul>
</section>

<style>
  .comms { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .comms li { display: grid; grid-template-columns: 16px 64px 1fr auto; gap: var(--space-2); align-items: center; min-width: 0; }
  .comms li > * { min-width: 0; }
  @media (max-width: 480px) {
    .comms li { grid-template-columns: 16px 1fr auto; }
    .comms__label { display: none; }
  }
  .comms__live { width: 16px; height: 16px; background: var(--lime); animation: px-blink var(--dur-blink) var(--ease-step) infinite; }
  .comms__label { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--ash); }
  .comms__value { font-family: var(--font-mono); font-size: 12px; color: var(--ink); overflow-wrap: anywhere; }
  .comms__state { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; color: var(--lime); }
</style>
