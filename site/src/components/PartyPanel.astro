---
import sprites from '../data/sprites.generated.json';
import player from '../data/player.generated.json';

const U = 4; // 64px 美术 × 4 = 256px，整数倍不糊
const palette = sprites.palette as Record<string, string>;
const heroes = sprites.sprites as { id: string; name: string; role: string; rects: number[][] }[];
const mage = heroes[0];
const knight = heroes[1];
const combat = (player as { combat?: Record<string, [string, number][]> }).combat ?? {};

function cells(sprite: { rects: number[][] }) {
  const out: { x: number; y: number; w: number; h: number; fill: string }[] = [];
  for (const r of sprite.rects) {
    if (r[5]) out.push({ x: (r[0] - 1) * U, y: (r[1] - 1) * U, w: (r[2] + 2) * U, h: (r[3] + 2) * U, fill: palette.K });
  }
  for (const r of sprite.rects) {
    out.push({ x: r[0] * U, y: r[1] * U, w: r[2] * U, h: r[3] * U, fill: palette[r[4]] });
  }
  return out;
}
---
<section class="panel span-12">
  <div class="panel__head"><span class="panel__tag">PARTY</span></div>
  <div class="party">
    {[mage, knight].map((h, i) => (
      <figure class="party__slot">
        <svg class="party__art" viewBox="0 0 256 256" width="256" height="256" shape-rendering="crispEdges" role="img" aria-label={h.name}>
          {cells(h).map((c) => <rect x={c.x} y={c.y} width={c.w} height={c.h} fill={c.fill} />)}
        </svg>
        <figcaption>
          <span class="party__name">{h.name}</span>
          <span class="party__role">{h.role}</span>
        </figcaption>
        <ul class="party__stats">
          {(combat[i === 0 ? 'mage' : 'knight'] ?? []).map(([label, val]) => (
            <li>
              <span class="party__key">{label}</span>
              <span class="party__bar">
                {Array.from({ length: 6 }, (_, b) => <i class={b < val ? 'on' : ''} />)}
              </span>
              <b>{val}</b>
            </li>
          ))}
        </ul>
      </figure>
    ))}
    <span class="party__vs" aria-hidden="true">VS</span>
  </div>
</section>

<style>
  .party {
    position: relative; display: grid; grid-template-columns: 1fr 1fr;
    gap: var(--space-4); align-items: start;
  }
  .party__vs {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    font-family: var(--font-mono); font-size: 12px; color: var(--ember);
    background: var(--surface); padding: 8px 12px; border-left: 4px solid var(--line);
    border-right: 4px solid var(--line);
  }
  .party__slot { margin: 0; display: grid; justify-items: center; gap: 8px; }
  .party__art {
    border: var(--px-border) solid var(--line); background: var(--bg);
    transition: transform var(--dur-press) var(--ease-step);
  }
  .party__slot:hover .party__art { transform: translateY(-4px); }
  figcaption { display: grid; justify-items: center; gap: 4px; }
  .party__name { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; color: var(--ink); }
  .party__role { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--ash); }
  .party__stats { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 8px; width: 100%; max-width: 256px; }
  .party__stats li { display: grid; grid-template-columns: 48px auto 24px; gap: 8px; align-items: center; }
  .party__key { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; color: var(--ash); }
  .party__bar { display: flex; gap: 4px; }
  .party__bar i { width: 16px; height: 16px; background: var(--line); display: block; }
  .party__bar i.on { background: var(--cyan); }
  .party__stats b { font-family: var(--font-mono); font-size: 12px; color: var(--ink); }
  /* 中等宽度：256px 精灵会挤，降到 192px（仍是 3 倍整数放大） */
  @media (max-width: 860px) {
    .party__art { width: 192px; height: 192px; }
  }
  /* 窄屏：两列放不下（2×(128+8)+32 = 304 加内边距），改单列 + 128px */
  @media (max-width: 560px) {
    .party { grid-template-columns: 1fr; }
    .party__art { width: 128px; height: 128px; }
    .party__vs { display: none; }
  }
</style>
