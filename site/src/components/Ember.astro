---
interface Props { size?: number }
const { size = 96 } = Astro.props;
---
<svg class="ember" width={size} height={size * 1.25} viewBox="0 0 32 40" role="img" aria-label="像素火焰">
  <g class="f1">
    <g fill="var(--ember)">
      <rect x="8" y="24" width="16" height="2" /><rect x="8" y="22" width="16" height="2" />
      <rect x="8" y="20" width="14" height="2" /><rect x="10" y="18" width="12" height="2" />
      <rect x="12" y="16" width="8" height="2" /><rect x="14" y="14" width="4" height="2" />
      <rect x="16" y="12" width="2" height="2" />
    </g>
    <g fill="var(--flame)">
      <rect x="10" y="24" width="10" height="2" /><rect x="10" y="22" width="10" height="2" />
      <rect x="12" y="20" width="6" height="2" /><rect x="14" y="18" width="3" height="2" />
    </g>
    <rect x="12" y="24" width="4" height="2" fill="var(--spark)" />
  </g>
  <g class="f2">
    <g fill="var(--ember)">
      <rect x="8" y="24" width="16" height="2" /><rect x="8" y="22" width="16" height="2" />
      <rect x="8" y="20" width="14" height="2" /><rect x="8" y="18" width="12" height="2" />
      <rect x="10" y="16" width="10" height="2" /><rect x="12" y="14" width="6" height="2" />
      <rect x="14" y="12" width="2" height="2" /><rect x="16" y="10" width="2" height="2" />
    </g>
    <g fill="var(--flame)">
      <rect x="10" y="24" width="10" height="2" /><rect x="10" y="22" width="10" height="2" />
      <rect x="12" y="20" width="6" height="2" /><rect x="14" y="18" width="2" height="2" />
    </g>
    <rect x="12" y="24" width="4" height="2" fill="var(--spark)" />
  </g>
  <g class="f3">
    <g fill="var(--ember)">
      <rect x="8" y="24" width="16" height="2" /><rect x="8" y="22" width="16" height="2" />
      <rect x="8" y="20" width="14" height="2" /><rect x="10" y="18" width="10" height="2" />
      <rect x="12" y="16" width="6" height="2" /><rect x="14" y="14" width="2" height="2" />
    </g>
    <g fill="var(--flame)">
      <rect x="10" y="24" width="10" height="2" /><rect x="10" y="22" width="8" height="2" />
      <rect x="12" y="20" width="4" height="2" />
    </g>
    <rect x="12" y="24" width="4" height="2" fill="var(--spark)" />
  </g>
  <style>
    .f2, .f3 { opacity: 0; }
    .f1 { animation: fr1 720ms steps(1, end) infinite; }
    .f2 { animation: fr2 720ms steps(1, end) infinite; }
    .f3 { animation: fr3 720ms steps(1, end) infinite; }
    @keyframes fr1 { 0%, 33.32% { opacity: 1 } 33.33%, 100% { opacity: 0 } }
    @keyframes fr2 { 0%, 33.32% { opacity: 0 } 33.33%, 66.65% { opacity: 1 } 66.66%, 100% { opacity: 0 } }
    @keyframes fr3 { 0%, 66.65% { opacity: 0 } 66.66%, 100% { opacity: 1 } }
    @media (prefers-reduced-motion: reduce) { .f1, .f2, .f3 { animation: none } .f1 { opacity: 1 } }
  </style>
</svg>
