---
import Gauge from './Gauge.astro';
import player from '../data/player.generated.json';

const { name, title, level, exp, stats } = player;
---
<section class="panel span-7">
  <div class="panel__head"><span class="panel__tag">PLAYER</span></div>
  <div class="player">
    <div class="player__avatar" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="96" height="96">
        <rect x="6" y="2" width="12" height="2" fill="var(--ember)" />
        <rect x="7" y="3" width="10" height="9" fill="var(--ink)" />
        <rect x="9" y="6" width="2" height="2" fill="var(--bg)" />
        <rect x="14" y="6" width="2" height="2" fill="var(--bg)" />
        <rect x="11" y="9" width="3" height="1" fill="var(--bg)" />
        <rect x="7" y="13" width="10" height="7" fill="var(--ember)" />
        <rect x="4" y="14" width="3" height="5" fill="var(--ember)" />
        <rect x="17" y="14" width="3" height="5" fill="var(--ember)" />
        <rect x="11" y="14" width="2" height="4" fill="var(--gold)" />
        <rect x="8" y="20" width="3" height="2" fill="var(--ember-deep)" />
        <rect x="13" y="20" width="3" height="2" fill="var(--ember-deep)" />
      </svg>
    </div>
    <div class="player__id">
      <h2 class="player__name">{name}</h2>
      <p class="player__title">{title}</p>
      <div class="player__exp">
        <span class="player__lv">LV.{String(level).padStart(2, '0')}</span>
        <Gauge value={exp.current} max={exp.next} cells={9} tone="gold" label={`EXP ${exp.current}/${exp.next}`} />
        <span class="player__num">{exp.current}/{exp.next}</span>
      </div>
    </div>
  </div>
  <ul class="player__stats">
    {stats.map((s) => (
      <li>
        <span class="player__key">{s.key}</span>
        <Gauge value={s.value} max={s.max} cells={10} tone="cyan" label={`${s.key} ${s.value}/${s.max}`} />
        <b class="player__val">{s.value}</b>
      </li>
    ))}
  </ul>
</section>

<style>
  .player { display: flex; gap: var(--space-4); align-items: flex-start; flex-wrap: wrap; }
  .player__avatar { border: 2px solid var(--line); background: var(--bg); padding: 8px; flex: none; }
  .player__name { font-family: var(--font-display); font-size: 16px; margin: 0 0 6px; color: var(--ink); }
  .player__title { font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; color: var(--ash); margin: 0 0 var(--space-3); }
  .player__exp { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .player__lv { font-family: var(--font-mono); font-size: 14px; color: var(--gold); letter-spacing: 1px; }
  .player__num { font-family: var(--font-mono); font-size: 11px; color: var(--ash); }
  .player__stats { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: grid; gap: 10px; }
  .player__stats li { display: grid; grid-template-columns: 72px auto 1fr; gap: var(--space-2); align-items: center; }
  .player__key { font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; color: var(--ink); }
  .player__val { font-family: var(--font-mono); font-size: 12px; color: var(--cyan); }
</style>
