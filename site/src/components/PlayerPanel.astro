---
import Gauge from './Gauge.astro';
import player from '../data/player.generated.json';
import sprites from '../data/sprites.generated.json';

const { name, title, level, exp, stats } = player;

// 头像复用队伍的鸡毛法师（32x32，unit=3 → 96px）
const U = 2; // 64px 美术 × 2 = 128px
const palette = sprites.palette as Record<string, string>;
const mage = (sprites.sprites as { rects: number[][] }[])[0];

function cells(sprite: { rects: number[][] }) {
  const out: { x: number; y: number; w: number; h: number; fill: string }[] = [];
  for (const r of sprite.rects) {
    if (r[5]) out.push({ x: (r[0] - 1) * U, y: (r[1] - 1) * U, w: (r[2] + 2) * U, h: (r[3] + 2) * U, fill: palette.K });
  }
  for (const r of sprite.rects) {
    out.push({ x: r[0] * U, y: r[1] * U, w: r[2] * U, h: r[3] * U, fill: palette[r[4]] });
  }
  return out;
}
---
<section class="panel span-7">
  <div class="panel__head"><span class="panel__tag">PLAYER</span></div>
  <div class="player">
    <div class="player__avatar">
      <svg viewBox="0 0 128 128" width="128" height="128" shape-rendering="crispEdges" role="img" aria-label="鸡毛法师头像">
        {cells(mage).map((c) => <rect x={c.x} y={c.y} width={c.w} height={c.h} fill={c.fill} />)}
      </svg>
    </div>
    <div class="player__id">
      <h2 class="player__name">{name}</h2>
      <p class="player__title">{title}</p>
      <div class="player__exp">
        <span class="player__lv">LV.{String(level).padStart(2, '0')}</span>
        <Gauge value={exp.current} max={exp.next} cells={9} tone="gold" label={`EXP ${exp.current}/${exp.next}`} />
        <span class="player__num">{exp.current}/{exp.next}</span>
      </div>
    </div>
  </div>
  <ul class="player__stats">
    {stats.map((s) => (
      <li>
        <span class="player__key">{s.key}</span>
        <Gauge value={s.value} max={s.max} cells={10} tone="cyan" label={`${s.key} ${s.value}/${s.max}`} />
        <b class="player__val">{s.value}</b>
      </li>
    ))}
  </ul>
</section>

<style>
  .player { display: flex; gap: var(--space-4); align-items: flex-start; flex-wrap: wrap; }
  .player__avatar { border: var(--px-border) solid var(--line); background: var(--bg); padding: 8px; flex: none; line-height: 0; }
  .player__name { font-family: var(--font-display); font-size: var(--fs-md); margin: 0 0 8px; color: var(--ink); }
  .player__title { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--ash); margin: 0 0 var(--space-3); }
  .player__exp { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .player__lv { font-family: var(--font-mono); font-size: 12px; color: var(--gold); letter-spacing: 1px; }
  .player__num { font-family: var(--font-mono); font-size: 12px; color: var(--ash); }
  .player__stats { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: grid; gap: 8px; }
  .player__stats li { display: grid; grid-template-columns: 96px auto 1fr; gap: var(--space-2); align-items: center; }
  .player__key { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--ink); }
  .player__val { font-family: var(--font-mono); font-size: 12px; color: var(--cyan); }
  /* 窄屏：10 格 × 24px 的仪表会把 li 撑破栅格，格子降到 16px（仍是整数） */
  @media (max-width: 720px) {
    .player__stats li { grid-template-columns: 72px auto 1fr; }
    .player__stats :global(.gauge i) { width: 16px; height: 12px; }
  }
</style>
