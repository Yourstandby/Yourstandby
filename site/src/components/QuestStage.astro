---
import { base } from '../data/site.ts';
import Bi from './Bi.astro';
import { copy } from '../i18n/copy.ts';

const SNOW = '#B8D8E8', FOREST = '#4CE06A', DESERT = '#C98F3D', QUARRY = '#8B929B', WATER = '#2BD9FF';
// key 与 quest.json 的 env 对齐；文案（地名 / 两侧解法）全部来自 i18n/copy.ts
const ENVS = [
  { key: 'snow', env: SNOW },
  { key: 'forest', env: FOREST },
  { key: 'desert', env: DESERT },
  { key: 'quarry', env: QUARRY },
  { key: 'water', env: WATER }
] as const;
type StageCopy = { place: { en: string; zh: string }; l: { en: string; zh: string }; r: { en: string; zh: string } };
const stageCopy = copy.stages as unknown as Record<string, StageCopy>;
const STAGES = ENVS.map((e) => ({ env: e.env, ...stageCopy[e.key] }));
const first = STAGES[0];

// canvas 里的 HUD 由 quest.js 写，它拿不到构建期的字典：两种语言都挂在 data-i18n 上，
// 切换时 quest.js 监听 langchange 自己换（读不到就退回它内置的中文）。
const stageI18n = {
  en: Object.fromEntries(
    ENVS.map((e) => [e.key, { place: stageCopy[e.key].place.en, l: stageCopy[e.key].l.en, r: stageCopy[e.key].r.en }])
  ),
  zh: Object.fromEntries(
    ENVS.map((e) => [e.key, { place: stageCopy[e.key].place.zh, l: stageCopy[e.key].l.zh, r: stageCopy[e.key].r.zh }])
  )
};

const trials = copy.a11y.trials;
---
<section class="panel span-12" id="trials-stage">
  <div class="panel__head trial__head">
    <span class="panel__tag"><Bi {...copy.panels.trials} /></span>
    <span class="trial__count"><b id="quest-idx">01</b> / 05</span>
  </div>

  <div class="stage">
    <canvas
      id="quest-canvas"
      width="640"
      height="180"
      data-base={base}
      data-i18n={JSON.stringify(stageI18n)}
      aria-label={trials.en}
      data-a11y-en={trials.en}
      data-a11y-zh={trials.zh}
    ></canvas>
  </div>

  <div class="stage__cap">
    <span class="stage__who is-mage"><Bi {...copy.party.mage} /></span>
    <span class="stage__place" id="quest-place"><Bi {...first.place} /></span>
    <span class="stage__who is-knight"><Bi {...copy.party.knight} /></span>
    <span class="stage__tech" id="quest-tech"><Bi en={first.l.en + ' / ' + first.r.en} zh={first.l.zh + ' / ' + first.r.zh} /></span>
  </div>

  <ol class="trk" id="quest-track">
    {STAGES.map((s) => (
      <li class="trk__dot" style={`--env:${s.env}`}>
        <span class="trk__name"><Bi {...s.place} /></span>
      </li>
    ))}
  </ol>
</section>

<style>
  .trial__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .trial__count { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--ash); }
  .trial__count b { color: var(--ember); font-size: 24px; }
  .stage {
    border: var(--px-border) solid var(--line); background: #0B0C0E; line-height: 0;
    max-width: 1280px; margin: 0 auto;
  }
  .stage canvas {
    width: 100%; height: auto; display: block;
    image-rendering: pixelated; image-rendering: crisp-edges;
  }
  .stage__cap {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center;
    gap: 8px var(--space-2); margin-top: var(--space-3); min-height: 24px;
  }
  .stage__who { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; }
  .stage__who.is-mage { color: var(--cyan); }
  .stage__who.is-knight { color: var(--ink); }
  .stage__place { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--gold); }
  .stage__tech { flex-basis: 100%; text-align: center; font-size: 12px; color: var(--ink-dim); }

  .trk { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .trk__dot {
    border: 2px solid var(--line); background: var(--bg); padding: 8px 4px;
    text-align: center; font-family: var(--font-mono); font-size: 12px;
    color: var(--ash); transition: background var(--dur-press) var(--ease-step);
  }
  .trk__dot.is-done { border-color: var(--gold); background: color-mix(in srgb, var(--env) 24%, var(--bg)); color: var(--ink); }
  .trk__dot.is-cur { border-color: var(--ember); color: var(--ink); box-shadow: 0 0 0 2px color-mix(in srgb, var(--ember) 30%, transparent); }
  @media (max-width: 640px) { .trk__dot { font-size: 12px; padding: 8px 4px; } }
</style>
