---
import { base } from '../data/site.ts';

const MAGE = ['雪原', '原始森林', '沙漠', '石坑', '水底'];
const KNIGHT = ['水底', '石坑', '沙漠', '原始森林', '雪原'];
---
<section class="panel span-12" id="trials">
  <div class="panel__head trial__head">
    <span class="panel__tag">THE TEN TRIALS</span>
    <span class="trial__count"><b id="quest-idx">01</b> / 10</span>
  </div>

  <div class="stage">
    <canvas
      id="quest-canvas"
      width="320"
      height="180"
      data-base={base}
      aria-label="十关闯关动画：鸡毛法师从左、小白战士从右，各自通过五种环境在中央相遇"
    ></canvas>
  </div>

  <div class="stage__cap">
    <span class="stage__who" id="quest-who">鸡毛法师</span>
    <span class="stage__place" id="quest-place">雪原</span>
    <span class="stage__tech" id="quest-tech">法杖点地，一道冰墙拔地而起挡住雪崩</span>
  </div>

  <div class="trk">
    <ol class="trk__side trk__side--mage" id="quest-track-mage">
      {MAGE.map((p) => <li class="trk__dot is-mage" title={p}><span>{p}</span></li>)}
    </ol>
    <span class="trk__mid" aria-hidden="true">VS</span>
    <ol class="trk__side trk__side--knight" id="quest-track-knight">
      {KNIGHT.slice().reverse().map((p) => <li class="trk__dot is-knight" title={p}><span>{p}</span></li>)}
    </ol>
  </div>
</section>

<style>
  .trial__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .trial__count { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--ash); }
  .trial__count b { color: var(--ember); font-size: 15px; }
  .stage {
    border: 2px solid var(--line); background: #0B0C0E; line-height: 0;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.35);
  }
  .stage canvas {
    width: 100%; height: auto; display: block;
    image-rendering: pixelated; image-rendering: crisp-edges;
  }
  .stage__cap {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2);
    margin-top: var(--space-3); min-height: 22px;
  }
  .stage__who { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--ember); }
  .stage__place { font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px; color: var(--cyan); }
  .stage__tech { font-size: 13px; color: var(--ink-dim); }

  .trk { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-3); align-items: center; margin-top: var(--space-3); }
  .trk__side { list-style: none; margin: 0; padding: 0; display: flex; gap: 4px; align-items: center; }
  .trk__side--mage { justify-content: flex-start; }
  .trk__side--knight { justify-content: flex-end; }
  .trk__mid { font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; color: var(--ash); }
  .trk__dot {
    flex: 1; min-width: 0; height: 18px; border: 2px solid var(--line); background: var(--bg);
    display: grid; place-items: center; font-family: var(--font-mono); font-size: 9px;
    color: transparent; transition: background var(--dur-press) var(--ease-step), color var(--dur-press) var(--ease-step);
  }
  .trk__dot span { white-space: nowrap; overflow: hidden; text-overflow: clip; }
  .trk__dot.is-mage.is-done { background: var(--cyan); border-color: var(--cyan); }
  .trk__dot.is-knight.is-done { background: var(--ink); border-color: var(--ink); }
  .trk__dot.is-cur { border-color: var(--gold); }
  .trk__dot.is-cur span { color: var(--gold); }
  @media (max-width: 640px) {
    .trk__dot span { display: none; }
    .trk__dot { height: 12px; }
  }
</style>
