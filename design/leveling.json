{
  "_note": "等级曲线与 XP 权重。gen_cards.py 每次跑都会用它把 GitHub 数据换算成 level/exp，写回 design/player.json。改这里就能调快慢。",
  "weights": {
    "commits": 2,
    "pull_requests": 40,
    "issues": 15,
    "stars": 25,
    "repos": 40,
    "followers": 30
  },
  "curve": {
    "base": 250,
    "exponent": 1.3,
    "max_level": 99
  },
  "never_demote": true,
  "_party_note": "队伍成员等级 = 主角等级 + offset，MAGE 与主角同级、KNIGHT 多练两年；卡片与站点都从这里取值。",
  "party": {
    "mage": { "offset": 0 },
    "knight": { "offset": 2 }
  },
  "_combat_note": "属性值 = round(10 * sqrt(加权指标 / ref))，夹在 [floor, 10]。ref 是打满格需要的量，想让人物更强就调小。",
  "combat": {
    "floor": 1,
    "mage": {
      "HP": { "from": { "commits": 1 }, "ref": 1200 },
      "MP": { "from": { "pull_requests": 1 }, "ref": 300 },
      "INT": { "from": { "repos": 1, "stars": 3 }, "ref": 70 }
    },
    "knight": {
      "HP": { "from": { "commits": 1, "pull_requests": 5 }, "ref": 1500 },
      "ATK": { "from": { "pull_requests": 1 }, "ref": 200 },
      "DEF": { "from": { "repos": 1 }, "ref": 25 }
    }
  }
}
